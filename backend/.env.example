# Copy to backend/.env — this file is gitignored and never read by the frontend.
# Google Gemini (default AI provider): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Or use xAI Grok instead by setting XAI_API_KEY (and leaving GEMINI_API_KEY empty)
# XAI_API_KEY=
# Only curate from these stores (comma-separated, max 5). Leave empty for the whole web.
ALLOWED_DOMAINS=nike.com
# PORT=8000

# Optional: faster background removal via an API instead of local rembg.
# Product-only photos on flat backgrounds never need these (keyed locally for free).
# PHOTOROOM_API_KEY=
# REMOVEBG_API_KEY=
# CUTOUT_PROVIDER=photoroom   # photoroom | removebg | local (auto-picked from keys)
