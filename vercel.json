{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd frontend && npm install",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "backend/*.py,backend/dataset/catalog.json,backend/dataset/removed.json",
      "excludeFiles": "{frontend/**,backend/data/**,backend/dataset/cutouts/**,backend/seed/**,docs/**,.git/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/signup", "destination": "/index.html" },
    { "source": "/h/:id", "destination": "/index.html" }
  ]
}
